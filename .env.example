# Copy to .env (make env does it) and edit.

# PostgreSQL password for the psu role (only psud uses it; the database is not published).
# make env fills in a random one; compose refuses to start while it is empty.
POSTGRES_PASSWORD=

# The IPv4 address players reach this server on (login sends clients to it for the game server).
PSU_GAME_ADDR=

# Discs to serve: psu, aoti, or both. Empty: every disc ./data was built for.
PSU_DISCS=

# 1: an unknown login name registers with the password it was given. 0: accounts come from psuctl.
PSU_AUTOREGISTER=1

# The login notice box when no news has been posted (about 50 characters fit a line).
PSU_MOTD=Welcome to the Phantasy Star Universe server.

# The Uni-cube's universes (each has its own lobbies): id:name, comma separated.
PSU_UNIVERSES=1:Universe 1,2:Universe 2,3:Universe 3

# The game data directory make import builds.
PSU_DATA=./data

# Address the game ports are published on (0.0.0.0 = every interface).
PSU_PUBLISH_ADDR=0.0.0.0

# Close a client silent this many seconds. One address (a household behind one router) may
# hold PSU_MAX_PER_IP connections across all ports at once, and open PSU_CONN_PER_MIN a minute.
PSU_IDLE_SECS=600
PSU_MAX_PER_IP=16
PSU_CONN_PER_MIN=60
# Connections from everyone together, and new accounts one address may auto-register an
# hour (names in PSU_ADMINS never auto-register: make them with make ctl ARGS="create NAME").
PSU_MAX_CONNS=2000
PSU_REGISTER_PER_HOUR=3

# debug logs every connection and patch command; info logs logins and errors.
PSU_LOG_LEVEL=info

# Account names (comma list) allowed the "!" GM chat commands.
PSU_ADMINS=

# Lobby season: none, auto (by date) or a season name (snow, halloween, christmas, ...). A
# running event's season wins. With a season on, 1 in PSU_SEASON_DROP kills that drop nothing
# give one of its holiday items (0 = never).
PSU_SEASON=none
PSU_SEASON_DROP=40

# The news ticker shows the next notice this often (0 = off). The public board JSON
# (state volume, board/board.json) is rewritten this often.
PSU_NEWS_TICKER_SECS=1800
PSU_BOARD_SECS=60

# Where the Python extractor (prettystellaruniverse/extract) lives, for make import.
PSU_EXTRACT_SRC=./prettystellaruniverse/extract
